---
import FormattedDate from './FormattedDate.astro';
import { readingTime, type Category, type Post } from '../lib/content';

interface Props {
  post: Post;
  category?: Category;
}
const { post, category } = Astro.props;
const { title, description, pubDate, heroImage, heroAlt, featured } = post.data;
const href = `/blog/${post.id}/`;
---

<article class="featured">
  <a href={href} class="media" tabindex="-1" aria-hidden="true">
    {
      heroImage ? (
        <img src={heroImage} alt={heroAlt ?? ''} />
      ) : (
        <span class="cover-fallback">{category?.data.name ?? 'Ethanet.XYZ'}</span>
      )
    }
  </a>
  <div class="content">
    <p class="kicker">
      <span class="badge">{featured ? 'Featured' : 'Latest'}</span>
      {category && <a href={`/category/${category.id}/`}>{category.data.name}</a>}
    </p>
    <h2><a href={href}>{title}</a></h2>
    <p class="desc">{description}</p>
    <p class="meta">
      <FormattedDate date={pubDate} />
      <span aria-hidden="true">·</span>
      <span>{readingTime(post.body)} min read</span>
    </p>
    <a href={href} class="btn">Read the post <span aria-hidden="true">→</span></a>
  </div>
</article>

<style>
  .featured {
    display: grid;
    grid-template-columns: 1fr;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: calc(var(--radius) + 6px);
    overflow: hidden;
    box-shadow: var(--shadow);
  }
  @media (min-width: 860px) {
    .featured {
      grid-template-columns: 1.35fr 1fr;
    }
  }
  .media {
    display: block;
    aspect-ratio: 16 / 10;
    background: var(--bg-soft);
    overflow: hidden;
  }
  @media (min-width: 860px) {
    .media {
      aspect-ratio: auto;
      min-height: 380px;
    }
  }
  .media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
    transition: transform 0.4s ease;
  }
  .featured:hover .media img {
    transform: scale(1.02);
  }
  .media .cover-fallback {
    font-size: clamp(1.75rem, 4vw, 2.75rem);
  }
  .content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.9rem;
    padding: 1.5rem 1.5rem 1.75rem;
  }
  @media (min-width: 860px) {
    .content {
      padding: 2.5rem 2.5rem 2.5rem 2.25rem;
    }
  }
  .kicker {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0;
    font-size: 0.85rem;
  }
  .badge {
    background: var(--brand-soft);
    color: var(--brand);
    font-weight: 600;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
  }
  .kicker a {
    color: var(--text-muted);
    font-weight: 500;
    text-decoration: none;
  }
  .kicker a:hover {
    color: var(--link);
  }
  h2 {
    margin: 0;
    font-size: clamp(1.6rem, 3.4vw, 2.3rem);
    letter-spacing: -0.02em;
  }
  h2 a {
    color: var(--text);
    text-decoration: none;
  }
  h2 a:hover {
    color: var(--brand);
  }
  .desc {
    margin: 0;
    color: var(--text-muted);
    font-size: 1.05rem;
    line-height: 1.6;
  }
  .meta {
    display: flex;
    gap: 0.4rem;
    margin: 0;
    font-size: 0.85rem;
    color: var(--text-muted);
  }
  .btn {
    align-self: flex-start;
    margin-top: 0.35rem;
  }
</style>
