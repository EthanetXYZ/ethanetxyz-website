---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import CategoryNav from '../../components/CategoryNav.astro';
import { getCategoryMap, getPosts } from '../../lib/content';

const posts = await getPosts();
const catMap = await getCategoryMap();
---

<Base title="Blog" description="Every post on Ethanet.XYZ.">
  <header class="container page-head">
    <h1>Blog</h1>
    <p class="muted">Everything I've written, newest first.</p>
  </header>
  <section class="container section">
    <CategoryNav />
    <div class="grid list">
      {posts.map((p) => <PostCard post={p} category={catMap.get(p.data.category.id)} />)}
    </div>
    {posts.length === 0 && <p class="muted">No posts yet.</p>}
  </section>
</Base>

<style>
  .list {
    margin-top: 1.5rem;
  }
</style>
