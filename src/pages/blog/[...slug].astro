---
import type { GetStaticPaths } from 'astro';
import { getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts, readingTime, slugifyTag, type Post } from '../../lib/content';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}) satisfies GetStaticPaths;

const { post, newer, older } = Astro.props as { post: Post; newer?: Post; older?: Post };
const { title, description, pubDate, updatedDate, heroImage, heroAlt, tags } = post.data;
const category = await getEntry(post.data.category);
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2);
---

<Base title={title} description={description} image={heroImage} type="article">
  <article class="container narrow">
    <header class="head">
      <p class="meta">
        {category && <a href={`/category/${category.id}/`}>{category.data.name}</a>}
        <FormattedDate date={pubDate} />
        <span aria-hidden="true">·</span>
        <span>{readingTime(post.body)} min read</span>
      </p>
      <h1>{title}</h1>
      <p class="lede muted">{description}</p>
      {
        updatedDate && (
          <p class="updated muted">
            Updated <FormattedDate date={updatedDate} />
          </p>
        )
      }
    </header>

    {heroImage && <img class="hero" src={heroImage} alt={heroAlt ?? ''} />}

    {
      toc.length >= 3 && (
        <details class="toc">
          <summary>On this page</summary>
          <ol>
            {toc.map((h) => (
              <li>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ol>
        </details>
      )
    }

    <div class="prose" data-pagefind-body>
      <span hidden data-pagefind-filter="category">{category?.data.name}</span>
      <span hidden data-pagefind-meta="date">{pubDate.toISOString().slice(0, 10)}</span>
      <Content />
    </div>

    {
      tags.length > 0 && (
        <p class="tags">
          {tags.map((t) => (
            <a class="chip" href={`/tags/${slugifyTag(t)}/`}>
              #{t}
            </a>
          ))}
        </p>
      )
    }
  </article>

  {
    (newer || older) && (
      <nav class="container narrow pager" aria-label="More posts">
        {older && <PostCard post={older} />}
        {newer && <PostCard post={newer} />}
      </nav>
    )
  }
</Base>

<style>
  .head {
    padding-block: 3rem 1.5rem;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.9rem;
    color: var(--text-muted);
    margin: 0 0 0.75rem;
  }
  .meta a {
    font-weight: 600;
    text-decoration: none;
    margin-right: 0.25rem;
  }
  h1 {
    margin: 0 0 0.75rem;
  }
  .lede {
    font-size: 1.15rem;
    margin: 0;
  }
  .updated {
    font-size: 0.85rem;
    margin: 0.5rem 0 0;
  }
  .hero {
    width: 100%;
    border-radius: var(--radius);
    margin-bottom: 1.5rem;
  }
  .toc {
    background: var(--bg-soft);
    border-radius: 10px;
    padding: 0.75rem 1.1rem;
    margin-bottom: 1.5rem;
    font-size: 0.95rem;
  }
  .toc summary {
    cursor: pointer;
    font-weight: 600;
  }
  .toc ol {
    margin: 0.5rem 0 0.25rem;
    padding-left: 1.25rem;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 2.5rem;
  }
  .pager {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }
</style>
