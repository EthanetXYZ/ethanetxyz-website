---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCategories, getCategoryMap, getPosts } from '../lib/content';

const posts = (await getPosts()).slice(0, 6);
const categories = await getCategories();
const catMap = await getCategoryMap();
const allPosts = await getPosts();
const featured = (await getCollection('projects', ({ data }) => data.featured))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
---

<Base>
  <section class="hero container">
    <p class="eyebrow">Ethanet.XYZ</p>
    <h1>Notes from the workbench.</h1>
    <p class="lede muted">
      A hobby blog about 3D printing, Home Assistant and the open source software I'm building — what worked, what
      didn't, and the files to try it yourself.
    </p>
  </section>

  <section class="container section">
    <ul class="cats">
      {
        categories.map((c) => {
          const count = allPosts.filter((p) => p.data.category.id === c.id).length;
          return (
            <li>
              <a href={`/category/${c.id}/`}>
                <strong>{c.data.name}</strong>
                <span class="muted">{c.data.description}</span>
                <span class="count">
                  {count} post{count === 1 ? '' : 's'}
                </span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </section>

  <section class="container section">
    <div class="section-title">
      <h2>Latest posts</h2>
      <a href="/blog/">All posts →</a>
    </div>
    {
      posts.length ? (
        <div class="grid">
          {posts.map((p) => (
            <PostCard post={p} category={catMap.get(p.data.category.id)} />
          ))}
        </div>
      ) : (
        <p class="muted">No posts yet — check back soon.</p>
      )
    }
  </section>

  {
    featured.length > 0 && (
      <section class="container section">
        <div class="section-title">
          <h2>Projects</h2>
          <a href="/projects/">All projects →</a>
        </div>
        <div class="grid">
          {featured.map((p) => (
            <ProjectCard project={p} />
          ))}
        </div>
      </section>
    )
  }
</Base>

<style>
  .hero {
    padding-block: 4.5rem 2rem;
  }
  .hero h1 {
    font-size: clamp(2.4rem, 7vw, 4rem);
    margin: 0 0 1rem;
  }
  .lede {
    font-size: 1.15rem;
    max-width: 58ch;
    margin: 0;
  }
  .cats {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
  }
  .cats a {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    height: 100%;
    padding: 1.1rem 1.25rem;
    border-radius: var(--radius);
    background: var(--bg-soft);
    border: 1px solid transparent;
    color: var(--text);
    text-decoration: none;
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .cats a:hover {
    border-color: var(--brand);
  }
  .cats strong {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
  }
  .count {
    margin-top: auto;
    padding-top: 0.25rem;
    font-size: 0.8rem;
    color: var(--brand);
    font-weight: 600;
  }
</style>
