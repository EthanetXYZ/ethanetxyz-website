---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import FeaturedPost from '../components/FeaturedPost.astro';
import PostCard from '../components/PostCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCategories, getCategoryMap, getPosts } from '../lib/content';

const allPosts = await getPosts();
// Hero: newest post ticked "Featured" in the CMS, else the newest post.
const hero = allPosts.find((p) => p.data.featured) ?? allPosts[0];
const latest = allPosts.filter((p) => p !== hero).slice(0, 6);
const categories = await getCategories();
const catMap = await getCategoryMap();
const featuredProjects = (await getCollection('projects', ({ data }) => data.featured))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
---

<Base>
  <section class="intro container">
    <h1>Notes from the workbench.</h1>
    <p class="lede">
      3D printing, Home Assistant and the open source software I'm building — what worked, what didn't, and the files to
      try it yourself.
    </p>
  </section>

  {
    hero && (
      <section class="container hero">
        <FeaturedPost post={hero} category={catMap.get(hero.data.category.id)} />
      </section>
    )
  }

  {
    latest.length > 0 && (
      <section class="container section">
        <div class="section-title">
          <h2>Latest posts</h2>
          <a href="/blog/">All posts →</a>
        </div>
        <div class="grid">
          {latest.map((p) => (
            <PostCard post={p} category={catMap.get(p.data.category.id)} />
          ))}
        </div>
      </section>
    )
  }

  <section class="container section">
    <div class="section-title">
      <h2>Browse by topic</h2>
    </div>
    <ul class="cats">
      {
        categories.map((c) => {
          const count = allPosts.filter((p) => p.data.category.id === c.id).length;
          return (
            <li>
              <a href={`/category/${c.id}/`}>
                <strong>{c.data.name}</strong>
                <span class="muted">{c.data.description}</span>
                <span class="count">
                  {count} post{count === 1 ? '' : 's'} →
                </span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </section>

  {
    featuredProjects.length > 0 && (
      <section class="container section">
        <div class="section-title">
          <h2>Projects</h2>
          <a href="/projects/">All projects →</a>
        </div>
        <div class="grid">
          {featuredProjects.map((p) => (
            <ProjectCard project={p} />
          ))}
        </div>
      </section>
    )
  }

  {allPosts.length === 0 && <p class="container muted">No posts yet — check back soon.</p>}
</Base>

<style>
  .intro {
    padding-block: 3.5rem 2rem;
  }
  .intro h1 {
    font-size: clamp(2.2rem, 6vw, 3.5rem);
    margin: 0 0 0.75rem;
  }
  .lede {
    font-size: 1.15rem;
    color: var(--text-muted);
    max-width: 56ch;
    margin: 0;
  }
  .hero {
    padding-bottom: 2.5rem;
  }
  .cats {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
  }
  .cats a {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    height: 100%;
    padding: 1.2rem 1.35rem;
    border-radius: var(--radius);
    background: var(--bg-soft);
    border: 1px solid transparent;
    color: var(--text);
    text-decoration: none;
    font-size: 0.95rem;
    line-height: 1.5;
    transition: border-color 0.15s, transform 0.15s;
  }
  .cats a:hover {
    border-color: var(--brand);
    transform: translateY(-2px);
  }
  .cats strong {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 600;
  }
  .count {
    margin-top: auto;
    padding-top: 0.35rem;
    font-size: 0.82rem;
    color: var(--brand);
    font-weight: 600;
  }
</style>
