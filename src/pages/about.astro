---
import Base from '../layouts/Base.astro';
---

<Base title="About" description="About Ethanet.XYZ.">
  <article class="container narrow">
    <header class="page-head">
      <h1>About</h1>
    </header>
    <div class="prose">
      <p>
        Hi! Ethanet.XYZ is where I write up the things I tinker with in my spare time — 3D printing, home
        automation with Home Assistant, my homelab, and the open source software I'm working on.
      </p>
      <p>
        Posts here are mostly build logs and notes-to-self that might save someone else an evening. If something helped
        you (or is wrong), I'd love to hear about it.
      </p>
      <h2>Elsewhere</h2>
      <ul>
        <li><a href="https://github.com/">GitHub</a></li>
      </ul>
    </div>
  </article>
</Base>
